# ============================================
# .gitignore — qué NO debe subirse a Git
# ============================================

# --- Secretos y credenciales (NUNCA subir) ---
.env
.env.*
*.key
*.pem
*.crt
secrets/
credenciales*
*password*

# --- Datos de contenedores / volúmenes ---
data/
*/data/
db_data/

# --- Logs y temporales ---
*.log
*.tmp
*~

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---
.vscode/
.idea/
*.swp
